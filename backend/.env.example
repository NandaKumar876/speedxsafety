# ============================================
# SpeedxSafety - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
# Leave empty or omit to allow all origins (development only!)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Rate Limiting (override defaults if needed)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# Future: Database connection
# DATABASE_URL=mongodb://localhost:27017/speedxsafety

# Future: JWT secret for auth tokens
# JWT_SECRET=change-me-to-a-random-secret
# JWT_EXPIRES_IN=7d
